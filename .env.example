# Optional. Without it, the dashboard and scraper use data/sample/*.json.
# MongoDB Atlas: Database > Connect > Drivers. Use a read-only user for the dashboard,
# a read-write user for the scraper.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=review_insights

# Scraper options
# BROWSER_CHANNEL=msedge   # use the installed Edge/Chrome ("chrome") instead of Playwright's Chromium
# SCRAPE_MAX_PAGES=40      # safety cap per property per run (10 reviews per page)

# Optional: built-in AI summary card via the Gemini API (the "Ask ChatGPT/Claude/Gemini" buttons need no key)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
